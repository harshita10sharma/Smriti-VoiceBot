# ============================================================================
# SMRITI VoiceBot configuration
# Copy to .env. NEVER commit .env, and never ship these values inside an APK,
# a Flutter bundle or browser JavaScript. They belong on the backend only.
# ============================================================================

# --- API authentication (required for a network-facing deployment) ----------
# Two mutually exclusive modes. Pick ONE.
#
# Mode 1 — single-user: one shared key, bound to exactly one elder. Simplest,
# and the original design. Generate a real key with:
#   python -m smriti_voice.api.generate_key
# Protected endpoints return 503 until SMRITI_API_KEY is set. That is deliberate.
SMRITI_API_KEY=change-this-server-key
SMRITI_AUTH_USER_ID=elder-1
#
# Mode 2 — multi-user: one backend serving MANY elderly users through one
# deployment. A JSON object mapping each key to the one user id it may act
# as; a caller can never use its key to claim a different user_id (every
# route checks the request body's user_id against this binding). Generate
# one key per elder with the command above, then build the object, e.g.:
#   SMRITI_API_KEYS={"<key-for-elder-1>":"elder-1","<key-for-elder-2>":"elder-2"}
# When this is set it takes priority — leave it unset for Mode 1, and leave
# SMRITI_API_KEY/SMRITI_AUTH_USER_ID unset (or ignored) for Mode 2.
# SMRITI_API_KEYS=
#
# Local development only. Never set this on anything reachable from a network.
# SMRITI_ALLOW_UNAUTHENTICATED=0

# --- Hugging Face (required only if SMRITI_INDIC_PARLER_ENABLED=1 below) ----
# Server-side credential used to download/authenticate the gated
# ai4bharat/indic-parler-tts model. Never returned by any endpoint, never sent
# to a client, and unrelated to SMRITI_API_KEY above.
HF_TOKEN=

# --- Provider credentials (all optional; absent = that provider is skipped) -
SARVAM_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- Model selection --------------------------------------------------------
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v2
SARVAM_CHAT_MODEL=sarvam-105b
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=gpt-4o-transcribe
OPENAI_INTENT_MODEL=gpt-5-mini
# Sarvam tool calling is unverified here. Set to 1 only after you have tested it.
SARVAM_TOOLS_VERIFIED=0

# --- Provider routing (auto = try local, then cloud in order) ---------------
SMRITI_LLM_PROVIDER=auto
SMRITI_TTS_PROVIDER=auto
SMRITI_ASR_PROVIDER=auto

# --- Offline / local inference ---------------------------------------------
# No model weights ship with SMRITI. Point these at a local OpenAI-compatible
# server (llama.cpp, Ollama, vLLM) and a local TTS HTTP endpoint.
# SMRITI_LOCAL_LLM_URL=http://127.0.0.1:8080
# SMRITI_LOCAL_LLM_MODEL=qwen2.5-3b-instruct-q4
# Only needed if your local OpenAI-compatible server requires its own auth token.
# SMRITI_LOCAL_LLM_KEY=
# SMRITI_LOCAL_TTS_URL=http://127.0.0.1:5002/synthesize
# SMRITI_LOCAL_TTS_LANGUAGES=hin,eng
SMRITI_FORCE_OFFLINE=0
# How long an "online" connectivity check is trusted before re-probing, and
# the timeout for that probe. Tuning knobs only; the defaults are fine.
# SMRITI_CONNECTIVITY_CACHE_SECONDS=20
# SMRITI_CONNECTIVITY_PROBE_TIMEOUT=1.5

# --- Indic Parler-TTS (local, offline, no API key) --------------------------
# ai4bharat/indic-parler-tts, downloaded once from HuggingFace and then cached
# on disk. Needs `torch`, `transformers` and `parler-tts` installed (they are
# NOT in requirements.txt by default because they are large; add them only if
# you enable this). Disabled by default: the base install boots without them.
SMRITI_INDIC_PARLER_ENABLED=0
# SMRITI_INDIC_PARLER_MODEL=ai4bharat/indic-parler-tts
# SMRITI_INDIC_PARLER_DEVICE=auto
# The languages this deployment actually serves through Indic Parler. Not a
# claim that the model supports only these — it is the operator's declared,
# validated subset. Defaults to the four Northeast/Himalayan languages Sarvam
# Bulbul does not cover: Assamese, Bodo, Manipuri, Nepali.
# SMRITI_INDIC_PARLER_LANGUAGES=asm,brx,mni,npi
# SMRITI_INDIC_PARLER_DESCRIPTION=a calm, neutral Indian voice

# --- Timeouts, retries and limits ------------------------------------------
SMRITI_REQUEST_TIMEOUT_S=20
SMRITI_LLM_TIMEOUT_S=30
SMRITI_TTS_TIMEOUT_S=30
SMRITI_MAX_RETRIES=2
SMRITI_RETRY_BACKOFF_S=0.5
SMRITI_RATE_LIMIT_PER_MINUTE=60

# --- Storage ----------------------------------------------------------------
SMRITI_DB_PATH=runtime/smriti.db
SMRITI_AUDIO_CACHE_DIR=runtime/audio
SMRITI_AUDIO_RETENTION_MINUTES=15

# --- Conversation -----------------------------------------------------------
SMRITI_MAX_HISTORY_TURNS=8
SMRITI_SESSION_IDLE_MINUTES=30

# --- Location used for weather when the user has none saved -----------------
SMRITI_DEFAULT_LOCATION=Guwahati
SMRITI_DEFAULT_LATITUDE=26.1445
SMRITI_DEFAULT_LONGITUDE=91.7362

# --- Logging ----------------------------------------------------------------
SMRITI_LOG_LEVEL=INFO
