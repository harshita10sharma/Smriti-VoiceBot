# ============================================================================
# SMRITI VoiceBot — STAGING configuration example
#
# This is a SANITIZED TEMPLATE with placeholder values. It contains NO real
# credentials and must never be filled in with real ones and committed.
# Copy to .env on your staging host and replace every placeholder.
#
# PILOT vs STAGING vs PRODUCTION — read this before using this file:
#
# - PILOT (what actually runs today): a single Windows PC, exposed via
#   Tailscale Funnel, one Uvicorn worker, SQLite on local disk, serving
#   exactly one real elder (`elder-1`). This is real, currently-live, but is
#   explicitly NOT production-grade infrastructure -- no SLA, no redundancy,
#   the PC must stay powered on. See SECURITY.md / INTEGRATION_CONTRACT.md.
# - STAGING (what this file is for): a separate, non-production deployment
#   the Backend/Flutter teams point their own staging environment at, using
#   staging-only credentials and a staging-only database, to develop and test
#   the integration without touching the real pilot patient's data.
# - PRODUCTION (does not exist yet): would need its own decision on hosting,
#   credential rotation process, and backup automation beyond what's
#   documented here — this codebase does not assume or build that for you.
#
# Nothing in this file changes what the application code does differently
# for "staging" vs "pilot" -- the only environment-mode switch that exists in
# code is SMRITI_ENV (development vs production, see below), which gates the
# unauthenticated-access foot-gun. Everything else that distinguishes
# staging from the pilot is simply: different credentials, different
# SMRITI_DB_PATH, different SMRITI_AUTH_USER_ID/SMRITI_API_KEYS, pointed at a
# different host.
# ============================================================================

# --- API authentication ------------------------------------------------------
# Generate a real staging key (never reuse the pilot's key):
#   python -m smriti_voice.api.generate_key
# Mode 1 — single test patient on staging:
SMRITI_API_KEY=REPLACE_WITH_A_GENERATED_STAGING_KEY
SMRITI_AUTH_USER_ID=staging-patient-1
#
# Mode 2 — multiple staging patients (recommended if Backend/Flutter need to
# test multi-patient flows before the pilot ever needs to):
# SMRITI_API_KEYS={"REPLACE_WITH_KEY_A":"staging-patient-1","REPLACE_WITH_KEY_B":["staging-patient-2","staging-patient-3"]}
#
# Never set this on staging if staging is reachable from any real network —
# it exists for a fully-isolated local dev loop only, and requires SMRITI_ENV
# below to also be "development" or the app refuses to start.
# SMRITI_ALLOW_UNAUTHENTICATED=0
#
# Staging should normally still be "production" here (fail-closed auth) even
# though it isn't the real pilot -- set "development" only for a throwaway,
# network-isolated local loop, never for a shared staging host.
SMRITI_ENV=production

# --- Hugging Face (only if SMRITI_INDIC_PARLER_ENABLED=1 below) -------------
HF_TOKEN=REPLACE_WITH_A_STAGING_HF_TOKEN_OR_LEAVE_EMPTY

# --- Provider credentials (all optional; absent = that provider is skipped) -
# Use STAGING/sandbox credentials from each provider where available, never
# the pilot's real keys.
SARVAM_API_KEY=REPLACE_OR_LEAVE_EMPTY
GEMINI_API_KEY=REPLACE_OR_LEAVE_EMPTY
OPENAI_API_KEY=REPLACE_OR_LEAVE_EMPTY
GROQ_API_KEY=REPLACE_OR_LEAVE_EMPTY

# --- Model selection (same defaults as the pilot; override only if testing
# a different model) -----------------------------------------------------
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_CHAT_MODEL=sarvam-105b
GEMINI_MODEL=gemini-3.7-flash
OPENAI_MODEL=gpt-4o-mini
GROQ_MODEL=qwen/qwen3.8-27b
OPENAI_STT_MODEL=gpt-4o-transcribe
OPENAI_INTENT_MODEL=gpt-5-mini
SARVAM_TOOLS_VERIFIED=0

# --- Provider routing ---------------------------------------------------
SMRITI_LLM_PROVIDER=groq
SMRITI_TTS_PROVIDER=auto
SMRITI_ASR_PROVIDER=auto

# --- Offline / local inference (optional; staging can use mock providers
# instead for fully offline/CI-friendly testing -- see README/HANDOFF) ----
# SMRITI_LOCAL_LLM_URL=http://127.0.0.1:8080
# SMRITI_LOCAL_LLM_MODEL=qwen2.5-3b-instruct-q4
# SMRITI_LOCAL_LLM_KEY=
# SMRITI_LOCAL_TTS_URL=http://127.0.0.1:5002/synthesize
# SMRITI_LOCAL_TTS_LANGUAGES=hin,eng
SMRITI_FORCE_OFFLINE=0
# SMRITI_CONNECTIVITY_CACHE_SECONDS=20
# SMRITI_CONNECTIVITY_PROBE_TIMEOUT=1.5

# --- Indic Parler-TTS (optional on staging; heavy, ~3.7GB download) --------
SMRITI_INDIC_PARLER_ENABLED=0
# SMRITI_INDIC_PARLER_MODEL=ai4bharat/indic-parler-tts
# SMRITI_INDIC_PARLER_DEVICE=auto
# SMRITI_INDIC_PARLER_LANGUAGES=asm,brx,mni,npi
# SMRITI_INDIC_PARLER_DESCRIPTION=a calm, neutral Indian voice

# --- Timeouts, retries and limits -------------------------------------------
SMRITI_REQUEST_TIMEOUT_S=20
SMRITI_LLM_TIMEOUT_S=30
SMRITI_TTS_TIMEOUT_S=30
SMRITI_MAX_RETRIES=2
SMRITI_RETRY_BACKOFF_S=0.5
# Staging is a good place to test rate-limit behavior deliberately -- lower
# this temporarily if you want to exercise 429 handling in your client.
SMRITI_RATE_LIMIT_PER_MINUTE=60
SMRITI_MAX_WAV_DURATION_S=60
SMRITI_VOICE_JOB_QUEUE_MAX=200
SMRITI_VOICE_JOB_PROCESSING_DEADLINE_S=180
SMRITI_IDEMPOTENCY_TTL_HOURS=24

# --- Storage ------------------------------------------------------------
# A staging-only database file/path -- never point staging at the pilot's
# runtime/smriti.db. Back it up with `python tools/backup_db.py backup`
# before any risky test that mutates data.
SMRITI_DB_PATH=runtime/staging-smriti.db
SMRITI_AUDIO_CACHE_DIR=runtime/staging-audio
SMRITI_AUDIO_RETENTION_MINUTES=15

# --- Conversation ---------------------------------------------------------
SMRITI_MAX_HISTORY_TURNS=8
SMRITI_SESSION_IDLE_MINUTES=30

# --- Location used for weather when the user has none saved ---------------
SMRITI_DEFAULT_LOCATION=Guwahati
SMRITI_DEFAULT_LATITUDE=26.1445
SMRITI_DEFAULT_LONGITUDE=91.7362

# --- Logging ----------------------------------------------------------------
SMRITI_LOG_LEVEL=INFO
