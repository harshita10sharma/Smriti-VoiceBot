{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListOwnBackupPrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::REPLACE_WITH_YOUR_BACKUP_BUCKET_NAME",
      "Condition": {
        "StringLike": { "s3:prefix": "smriti-voicebot/*" }
      }
    },
    {
      "Sid": "ReadWriteOwnBackupPrefix",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::REPLACE_WITH_YOUR_BACKUP_BUCKET_NAME/smriti-voicebot/*"
    }
  ]
}
