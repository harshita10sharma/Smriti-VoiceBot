# Environment template for the AWS deployment. Copy this file, fill in real
# values, and keep the filled-in copy OUT of git (it is not tracked; do not
# add it). See docs/AWS_DEPLOYMENT.md for what each variable means.

# --- Provisioning-time settings (used by provision.sh, not by the app) -----
AWS_REGION=ap-south-1
INSTANCE_TYPE=m6i.large
EBS_VOLUME_SIZE_GB=30
KEY_PAIR_NAME=smriti-voicebot-key
SECURITY_GROUP_NAME=smriti-voicebot-sg
INSTANCE_NAME=smriti-voicebot
SSH_ALLOWED_CIDR=  # set to YOUR_IP/32 -- never 0.0.0.0/0 for SSH

# --- Application secrets (set on the instance, never committed) ------------
SMRITI_API_KEY=
SMRITI_AUTH_USER_ID=
GROQ_API_KEY=
SARVAM_API_KEY=
HF_TOKEN=

# --- Application configuration (safe, non-secret) ---------------------------
SMRITI_ENV=production
SMRITI_LLM_PROVIDER=groq
GROQ_MODEL=qwen/qwen3.8-27b
SMRITI_TTS_PROVIDER=auto
SMRITI_INDIC_PARLER_ENABLED=1
SMRITI_INDIC_PARLER_LANGUAGES=asm,brx,mni,npi
SMRITI_INDIC_PARLER_DEVICE=cpu
SMRITI_DB_PATH=/data/smriti.db
SMRITI_AUDIO_CACHE_DIR=/data/audio
HF_HOME=/data/hf-cache
