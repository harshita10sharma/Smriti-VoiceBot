{
  "sample_rate": 16000,
  "channels": 1,
  "record_seconds": 6.0,
  "min_speech_seconds": 0.35,
  "max_speech_seconds": 6.0,
  "default_language": "auto",
  "language_pack_dir": "language_packs",
  "intent_threshold": 82.0,
  "ambiguity_margin": 8.0,
  "max_intent_candidates": 3,
  "audio_dir": "audio/responses",
  "recordings_dir": "data/voice_dataset/recordings",
  "telemetry_enabled": true,
  "telemetry_path": "logs/voice_events.jsonl",
  "retain_raw_audio": false,
  "api_key_env": "SMRITI_API_KEY",
  "max_upload_bytes": 10485760,
  "max_request_seconds": 8.0,
  "online_fallback": true,
  "sarvam_model": "saaras:v4",
  "openai_stt_model": "gpt-4o-transcribe",
  "semantic_intent_enabled": true
}
